<UserControl
    x:Class="SimplePad.Search.SearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="using:SimplePad.Search"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="883" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CompactMoreOptionsButton.Visibility" Value="Collapsed" />
                        <Setter Target="SearchDownButton.Visibility" Value="Visible" />
                        <Setter Target="SearchUpButton.Visibility" Value="Visible" />
                        <Setter Target="ExpandedMoreOptionsButton.Visibility" Value="Visible" />
                        <Setter Target="ReplaceSplitButton.Visibility" Value="Collapsed" />
                        <Setter Target="ReplaceButton.Visibility" Value="Visible" />
                        <Setter Target="ReplaceAllButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <search:ReplaceModeToggleButton />
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchTextBox"
                PlaceholderText="Find"
                QueryIcon="Find"
                TextChanged="OnSearchTextBoxTextChanged" />
            <Button
                x:Name="CompactMoreOptionsButton"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                ToolTipService.ToolTip="More options">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutSubItem Text="Find options">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9E9;" />
                            </MenuFlyoutSubItem.Icon>
                            <ToggleMenuFlyoutItem Text="Match case" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="Move up">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Move down">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" />
            </Button>
            <Button
                x:Name="SearchDownButton"
                Grid.Column="1"
                Visibility="Collapsed">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" />
            </Button>
            <Button
                x:Name="SearchUpButton"
                Grid.Column="2"
                Visibility="Collapsed">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" />
            </Button>
            <Button
                x:Name="ExpandedMoreOptionsButton"
                Grid.Column="3"
                ToolTipService.ToolTip="More options"
                Visibility="Collapsed">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9E9;" />
            </Button>
            <search:ExitFindAndReplaceButton Grid.Column="4" />
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Replace" />
            <SplitButton
                x:Name="ReplaceSplitButton"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Content="Replace">
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Replace all" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <Button
                x:Name="ReplaceButton"
                Grid.Column="1"
                Content="Replace"
                Visibility="Collapsed" />
            <Button
                x:Name="ReplaceAllButton"
                Grid.Column="2"
                Content="Replace all"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>