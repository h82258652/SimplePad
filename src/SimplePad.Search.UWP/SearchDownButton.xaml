<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:search="using:SimplePad.Search">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///SimplePad.Search.UWP/SearchControlIconButtonStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style BasedOn="{StaticResource SearchControlIconButtonStyle}" TargetType="search:SearchDownButton">
        <Setter Property="ToolTipService.ToolTip" Value="Search down" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>