<Button
    x:Class="SimplePad.Search.CompactMoreOptionsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Style="{StaticResource SearchControlIconButtonStyle}"
    ToolTipService.ToolTip="More options"
    mc:Ignorable="d">
    <Button.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///SimplePad.Search.UWP/SearchControlIconButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Button.Resources>
    <Button.Flyout>
        <MenuFlyout>
            <MenuFlyoutSubItem Text="Find options">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9E9;" />
                </MenuFlyoutSubItem.Icon>
                <ToggleMenuFlyoutItem Text="Match case" />
                <ToggleMenuFlyoutItem Text="Wrap around" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem Text="Move up">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Move down">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Button.Flyout>
    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" />
</Button>