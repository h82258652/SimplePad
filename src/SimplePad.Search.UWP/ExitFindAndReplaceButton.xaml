<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:search="using:SimplePad.Search">
    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="search:ExitFindAndReplaceButton">
        <Setter Property="ToolTipService.ToolTip" Value="Exit Find and Replace" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>