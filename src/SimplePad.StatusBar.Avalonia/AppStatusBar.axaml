<UserControl
    x:Class="SimplePad.StatusBar.AppStatusBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Panel MinHeight="32">
        <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CursorPositionText" />
            <Separator Grid.Column="1" />
            <TextBlock x:Name="CharacterIndicator" Grid.Column="2" />
            <Separator Grid.Column="4" />
            <TextBlock
                x:Name="ZoomFactorIndicator"
                Grid.Column="5"
                MinWidth="44" />
            <Separator Grid.Column="6" />
            <TextBlock Grid.Column="7" MinWidth="134" />
        </Grid>
    </Panel>
</UserControl>
