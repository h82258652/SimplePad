<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SimplePad.Windowing.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SimplePad.Windowing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="using:SimplePad.Search"
    xmlns:settings="using:SimplePad.Settings"
    xmlns:tabs="using:SimplePad.Tabs"
    Title="Simple Pad"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid x:Name="ContentGrid">
            <tabs:AppTabView x:Name="TabView" />
            <search:SearchControl
                MaxWidth="860"
                Margin="8,88,8,0"
                VerticalAlignment="Top" />
        </Grid>
        <settings:SettingsView />
    </Grid>
</Window>