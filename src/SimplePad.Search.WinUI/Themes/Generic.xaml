<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///SimplePad.Search.WinUI/ReplaceTextBox.xaml" />
        <ResourceDictionary Source="ms-appx:///SimplePad.Search.WinUI/SearchControlExpander.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="local:SearchUpButton" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SearchUpButton">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
