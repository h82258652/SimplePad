<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimplePad.Search.ExitFindAndReplaceButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="using:SimplePad.Search"
    mc:Ignorable="d">
    <Button ToolTipService.ToolTip="More options">
        <Button.Flyout>
            <MenuFlyout Placement="Bottom">
                <search:IsMatchCaseToggleMenuItem />
                <search:IsWrapAroundToggleMenuItem />
            </MenuFlyout>
        </Button.Flyout>
        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9E9;" />
    </Button>
</UserControl>