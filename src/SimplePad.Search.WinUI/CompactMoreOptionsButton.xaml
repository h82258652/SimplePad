<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimplePad.Search.CompactMoreOptionsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="using:SimplePad.Search"
    mc:Ignorable="d">
    <Button ToolTipService.ToolTip="More options">
        <Button.Flyout>
            <MenuFlyout Placement="Bottom">
                <MenuFlyoutSubItem Text="Find options">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9E9;" />
                    </MenuFlyoutSubItem.Icon>
                    <search:IsMatchCaseToggleMenuItem />
                    <search:IsWrapAroundToggleMenuItem />
                </MenuFlyoutSubItem>
                <search:MoveUpMenuItem />
                <search:MoveDownMenuItem />
            </MenuFlyout>
        </Button.Flyout>
        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" />
    </Button>
</UserControl>