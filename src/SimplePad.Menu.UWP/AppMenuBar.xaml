<MenuBar
    x:Class="SimplePad.Menu.AppMenuBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="using:SimplePad.Menu"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    Height="32"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <MenuBar.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <winui:XamlControlsResources />
                <ResourceDictionary Source="ms-appx:///SimplePad.Menu.UWP/AppMenuBarItemStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </MenuBar.Resources>
    <MenuBarItem
        Title="File"
        Margin="4,0,0,0"
        Style="{StaticResource AppMenuBarItemStyle}">
        <menu:NewTabMenuFlyoutItem MinWidth="230" TabRoot="{x:Bind Tab.Root, Mode=OneWay}" />
        <menu:NewWindowMenuFlyoutItem MinWidth="230" />
        <menu:OpenMenuItem MinWidth="230" />
        <menu:SaveMenuFlyoutItem MinWidth="230" Tab="{x:Bind Tab, Mode=OneWay}" />
        <menu:SaveAsMenuFlyoutItem MinWidth="230" Tab="{x:Bind Tab, Mode=OneWay}" />
        <menu:SaveAllMenuItem MinWidth="230" />
        <!--<MenuFlyoutSeparator MinWidth="230" />
        <menu:PrintMenuFlyoutItem MinWidth="230" Tab="{x:Bind Tab, Mode=OneWay}" />-->
        <MenuFlyoutSeparator MinWidth="230" />
        <menu:CloseTabMenuItem MinWidth="230" Tab="{x:Bind Tab, Mode=OneWay}" />
        <menu:CloseWindowMenuItem MinWidth="230" />
        <menu:ExitMenuItem MinWidth="230" />
    </MenuBarItem>
    <MenuBarItem
        Title="Edit"
        Margin="4,0,0,0"
        Style="{StaticResource AppMenuBarItemStyle}">
        <menu:UndoMenuFlyoutItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <MenuFlyoutSeparator MinWidth="230" />
        <menu:CutMenuItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <menu:CopyMenuFlyoutItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <menu:PasteMenuFlyoutItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <menu:DeleteMenuItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <MenuFlyoutSeparator MinWidth="230" />
        <menu:FindMenuFlyoutItem MinWidth="230" />
        <menu:FindNextMenuItem MinWidth="230" />
        <menu:FindPreviousMenuFlyoutItem MinWidth="230" />
        <menu:ReplaceMenuFlyoutItem MinWidth="230" />
        <menu:GoToLineMenuItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <MenuFlyoutSeparator MinWidth="230" />
        <menu:SelectAllMenuFlyoutItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <menu:TimeDateMenuItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <MenuFlyoutSeparator MinWidth="230" />
        <menu:FontMenuItem MinWidth="230" />
    </MenuBarItem>
    <MenuBarItem
        Title="View"
        Margin="4,0,0,0"
        Style="{StaticResource AppMenuBarItemStyle}">
        <MenuFlyoutSubItem
            MinWidth="230"
            Style="{StaticResource DefaultMenuFlyoutSubItemStyle}"
            Text="Zoom">
            <menu:ZoomInMenuItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
            <menu:ZoomOutMenuItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
            <menu:RestoreDefaultZoomMenuFlyoutItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        </MenuFlyoutSubItem>
        <menu:IsStatusBarVisibleToggleMenuFlyoutItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
        <menu:IsWordWrapToggleMenuFlyoutItem MinWidth="230" TextBox="{x:Bind TextBox, Mode=OneWay}" />
    </MenuBarItem>
</MenuBar>