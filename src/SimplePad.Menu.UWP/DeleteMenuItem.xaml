<MenuFlyoutItem
    x:Class="SimplePad.Menu.DeleteMenuItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="using:SimplePad.Menu"
    KeyboardAcceleratorTextOverride="Del"
    Style="{StaticResource DefaultMenuFlyoutItemStyle}"
    Text="Delete"
    mc:Ignorable="d">
    <MenuFlyoutItem.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" />
    </MenuFlyoutItem.KeyboardAccelerators>
    <MenuFlyoutItem.Command>
        <menu:DeleteCommand TextBox="{x:Bind TextBox, Mode=OneWay}" />
    </MenuFlyoutItem.Command>
</MenuFlyoutItem>