<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimplePad.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:SimplePad.Editor"
    xmlns:fonts="using:SimplePad.Fonts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:SimplePad.Settings"
    xmlns:tabs="using:SimplePad.Tabs"
    xmlns:themes="using:SimplePad.Themes"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="646" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleText.Margin" Value="0,22" />
                        <Setter Target="TitleText.Style" Value="{StaticResource TitleLargeTextBlockStyle}" />
                        <Setter Target="ContentScrollViewer.Padding" Value="54,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="958" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleText.Margin" Value="0,22" />
                        <Setter Target="TitleText.Style" Value="{StaticResource TitleLargeTextBlockStyle}" />
                        <Setter Target="ContentScrollViewer.Padding" Value="54,0" />
                        <Setter Target="SettingsSection.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SettingsSection.(Grid.RowSpan)" Value="2" />
                        <Setter Target="AboutSection.(Grid.Column)" Value="1" />
                        <Setter Target="AboutSection.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="AboutSection.(Grid.Row)" Value="0" />
                        <Setter Target="AboutSection.(Grid.RowSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <settings:BackButton Margin="6,0,0,0" VerticalAlignment="Center" />
            <Image
                Grid.Column="1"
                Width="28"
                Height="28"
                Margin="6,0,0,0"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="Simple Pad" />
            <Border />
        </Grid>
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="1"
            Padding="18,0">
            <StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,14"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />
                <Grid
                    Margin="0,0,0,20"
                    ColumnSpacing="58"
                    RowSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SettingsSection" Grid.ColumnSpan="2">
                        <TextBlock Text="Appearance" />
                        <toolkit:SettingsExpander
                            Margin="0,12,0,0"
                            Description="Select which app theme to display"
                            Header="App theme">
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                            </toolkit:SettingsExpander.HeaderIcon>
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard Background="{ThemeResource ControlFillColorSecondaryBrush}" ContentAlignment="Left">
                                    <themes:ThemeSettingsControl />
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                        <StackPanel x:Name="PanelBelowAppThemeSettingsExpander">
                            <animations:Implicit.Animations>
                                <animations:OffsetAnimation Duration="0:0:0.3" />
                            </animations:Implicit.Animations>
                            <TextBlock Margin="0,12,0,0" Text="Text Formatting" />
                            <toolkit:SettingsExpander
                                x:Name="FontSettingsExpander"
                                Margin="0,12,0,0"
                                Collapsed="OnFontSettingsExpanderCollapsed"
                                Expanded="OnFontSettingsExpanderExpanded"
                                Header="Font">
                                <toolkit:SettingsExpander.HeaderIcon>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D2;" />
                                </toolkit:SettingsExpander.HeaderIcon>
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Background="{ThemeResource ControlFillColorSecondaryBrush}" Header="Family">
                                        <fonts:FontFamilyComboBox MinWidth="198" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Background="{ThemeResource ControlFillColorSecondaryBrush}" Header="Style">
                                        <fonts:FontStyleComboBox MinWidth="198" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Background="{ThemeResource ControlFillColorSecondaryBrush}" Header="Size">
                                        <fonts:FontSizeComboBox MinWidth="198" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Padding="0,32,0,32"
                                        HorizontalContentAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        ContentAlignment="Vertical">
                                        <fonts:PreviewFontTextControl />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>
                            <StackPanel x:Name="PanelBelowFontSettingsExpander">
                                <animations:Implicit.Animations>
                                    <animations:OffsetAnimation Duration="0:0:0.3" />
                                </animations:Implicit.Animations>
                                <toolkit:SettingsCard
                                    Margin="0,4,0,0"
                                    Description="Fit text within window by default"
                                    Header="Word wrap">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE751;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <editor:IsWordWrapSettingsControl />
                                </toolkit:SettingsCard>
                                <TextBlock Margin="0,12,0,0" Text="Opening Simple Pad" />
                                <toolkit:SettingsCard
                                    Margin="0,12,0,0"
                                    Description="Choose where your files are opened"
                                    Header="Opening files">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <tabs:OpenFileBehaviorComboBox MinWidth="148" />
                                </toolkit:SettingsCard>
                                <TextBlock Margin="0,12,0,0" Text="Spelling" />
                                <toolkit:SettingsCard Margin="0,12,0,0" Header="Spell check">
                                    <toolkit:SettingsCard.HeaderIcon>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF87B;" />
                                    </toolkit:SettingsCard.HeaderIcon>
                                    <editor:IsSpellCheckEnabledSettingsControl />
                                </toolkit:SettingsCard>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        x:Name="AboutSection"
                        Grid.Row="1"
                        Grid.ColumnSpan="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About this app" />
                        <TextBlock Margin="0,8,0,0"><Run Text="Simple Pad " /><Run x:Name="VersionText" /></TextBlock>
                        <TextBlock Text="© 2026 h82258652. All rights reserved." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>