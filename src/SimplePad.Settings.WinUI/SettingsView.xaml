<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimplePad.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="using:SimplePad.Fonts"
    xmlns:local="using:SimplePad.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Middle" />
                <VisualState x:Name="Wide" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Margin="6,0,0,0" VerticalAlignment="Center" />
            <Image />
            <TextBlock
                Grid.Column="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="Simple Pad" />
            <Border />
        </Grid>
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="1"
            Padding="18,0">
            <StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,14"
                    Text="Settings" />
                <Grid
                    Margin="0,0,0,20"
                    ColumnSpacing="58"
                    RowSpacing="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SettingsSection" Grid.ColumnSpan="2">
                        <TextBlock Text="Appearance" />
                        <toolkit:SettingsExpander />
                        <StackPanel x:Name="PanelBelowAppThemeSettingsExpander">
                            <TextBlock Margin="0,12,0,0" Text="Text Formatting" />
                            <toolkit:SettingsExpander Margin="0,12,0,0">
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard>
                                        <fonts:FontFamilyComboBox MinWidth="198" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard>
                                        <fonts:FontStyleComboBox MinWidth="198" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard>
                                        <fonts:FontSizeComboBox MinWidth="198" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Padding="0,32,0,32"
                                        HorizontalContentAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        ContentAlignment="Vertical">
                                        <fonts:PreviewFontTextControl />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>
                            <StackPanel x:Name="PanelBelowFontSettingsExpander">
                                <animations:Implicit.Animations>
                                    <animations:OffsetAnimation Duration="0:0:0.3" />
                                </animations:Implicit.Animations>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        x:Name="AboutSection"
                        Grid.Row="1"
                        Grid.ColumnSpan="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About this app" />
                        <TextBlock Margin="0,8,0,0"><Run Text="Simple Pad " /><Run x:Name="VersionText" /></TextBlock>
                        <TextBlock Text="© 2026 h82258652. All rights reserved." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>