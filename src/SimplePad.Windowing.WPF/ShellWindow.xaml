<themes:ThemeWindow
    x:Class="SimplePad.Windowing.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SimplePad.Windowing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="clr-namespace:SimplePad.Search;assembly=SimplePad.Search.WPF"
    xmlns:settings="clr-namespace:SimplePad.Settings;assembly=SimplePad.Settings.WPF"
    xmlns:tabs="clr-namespace:SimplePad.Tabs;assembly=SimplePad.Tabs.WPF"
    xmlns:themes="clr-namespace:SimplePad.Themes;assembly=SimplePad.Themes.WPF"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Simple Pad"
    Width="800"
    Height="450"
    Closing="OnClosing"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid x:Name="ContentGrid">
            <tabs:AppTabView x:Name="TabView">
                <tabs:AppTabView.HeaderPrefixContent>
                    <Border Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                        <Image
                            Width="28"
                            Height="28"
                            Margin="9,0,5,0"
                            IsHitTestVisible="False">
                            <Image.Source>
                                <BitmapImage UriSource="pack://application:,,,/SimplePad.WPF.App;component/Assets/icon.png" />
                            </Image.Source>
                        </Image>
                    </Border>
                </tabs:AppTabView.HeaderPrefixContent>
                <tabs:AppTabView.HeaderSuffixContent>
                    <Border
                        Margin="0,0,144,0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" />
                </tabs:AppTabView.HeaderSuffixContent>
            </tabs:AppTabView>
            <search:SearchControl
                MaxWidth="860"
                Margin="8,88,8,0"
                VerticalAlignment="Top" />
        </Grid>
        <settings:SettingsView />
        <ui:ContentDialogHost x:Name="RootContentDialogHost" />
    </Grid>
</themes:ThemeWindow>