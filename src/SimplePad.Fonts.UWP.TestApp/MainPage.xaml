<Page
    x:Class="SimplePad.Fonts.TestApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="using:SimplePad.Fonts"
    xmlns:local="using:SimplePad.Fonts.TestApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="20">
        <fonts:FontFamilyComboBox Width="220" />
        <fonts:FontStyleComboBox Width="220" />
        <fonts:FontSizeComboBox Width="220" />
        <fonts:PreviewFontTextControl />
    </StackPanel>
</Page>
