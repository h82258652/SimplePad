<?xml version="1.0" encoding="utf-8" ?>
<TabViewItem
    x:Class="SimplePad.Tabs.AppTabViewItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:SimplePad.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="using:SimplePad.Menu"
    xmlns:settings="using:SimplePad.Settings"
    xmlns:statusbar="using:SimplePad.StatusBar"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <menu:AppMenuBar Tab="{x:Bind Tab, Mode=OneWay}" TextBox="{x:Bind TextBox}" />
            <settings:SettingsButton Grid.Column="1" Margin="0,0,8,0" />
        </Grid>
        <Rectangle
            Grid.Row="1"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <editor:AppTextBox
            x:Name="TextBox"
            Grid.Row="2"
            x:FieldModifier="internal"
            TextChanged="OnTextBoxTextChanged" />
        <Rectangle
            x:Name="StatusBarDivider"
            Grid.Row="3"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <statusbar:AppStatusBar
            x:Name="StatusBar"
            Grid.Row="4"
            TextBox="{x:Bind TextBox}" />
    </Grid>
</TabViewItem>