<UserControl
    x:Class="SimplePad.Themes.ThemeSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SimplePad.Themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <RadioButton
            x:Name="LightThemeRadioButton"
            Checked="OnLightThemeRadioButtonChecked"
            Content="Light"
            GroupName="AppTheme" />
        <RadioButton
            x:Name="DarkThemeRadioButton"
            Margin="0,8,0,0"
            Checked="OnDarkThemeRadioButtonChecked"
            Content="Dark"
            GroupName="AppTheme" />
        <RadioButton
            x:Name="UseSystemSettingsThemeRadioButton"
            Margin="0,8,0,0"
            Checked="OnUseSystemSettingsThemeRadioButtonChecked"
            Content="Use system setting"
            GroupName="AppTheme" />
    </StackPanel>
</UserControl>
