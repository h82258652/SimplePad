<UserControl
    x:Class="SimplePad.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="clr-namespace:SimplePad.Editor;assembly=SimplePad.Editor.Settings.WPF"
    xmlns:fonts="clr-namespace:SimplePad.Fonts;assembly=SimplePad.Fonts.Settings.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:SimplePad.Settings"
    xmlns:tabs="clr-namespace:SimplePad.Tabs;assembly=SimplePad.Tabs.Settings.WPF"
    xmlns:themes="clr-namespace:SimplePad.Themes;assembly=SimplePad.Themes.Settings.WPF"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Middle">
                    <Storyboard>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="TitleText" Storyboard.TargetProperty="Margin">
                            <DiscreteThicknessKeyFrame KeyTime="0" Value="0,22" />
                        </ThicknessAnimationUsingKeyFrames>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ContentScrollViewer" Storyboard.TargetProperty="Padding">
                            <DiscreteThicknessKeyFrame KeyTime="0" Value="54,0" />
                        </ThicknessAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Wide">
                    <Storyboard>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="TitleText" Storyboard.TargetProperty="Margin">
                            <DiscreteThicknessKeyFrame KeyTime="0" Value="0,22" />
                        </ThicknessAnimationUsingKeyFrames>
                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ContentScrollViewer" Storyboard.TargetProperty="Padding">
                            <DiscreteThicknessKeyFrame KeyTime="0" Value="54,0" />
                        </ThicknessAnimationUsingKeyFrames>
                        <Int32AnimationUsingKeyFrames Storyboard.TargetName="SettingsSection" Storyboard.TargetProperty="(Grid.ColumnSpan)">
                            <DiscreteInt32KeyFrame KeyTime="0" Value="1" />
                        </Int32AnimationUsingKeyFrames>
                        <Int32AnimationUsingKeyFrames Storyboard.TargetName="SettingsSection" Storyboard.TargetProperty="(Grid.RowSpan)">
                            <DiscreteInt32KeyFrame KeyTime="0" Value="3" />
                        </Int32AnimationUsingKeyFrames>
                        <Int32AnimationUsingKeyFrames Storyboard.TargetName="AboutSection" Storyboard.TargetProperty="(Grid.Column)">
                            <DiscreteInt32KeyFrame KeyTime="0" Value="2" />
                        </Int32AnimationUsingKeyFrames>
                        <Int32AnimationUsingKeyFrames Storyboard.TargetName="AboutSection" Storyboard.TargetProperty="(Grid.ColumnSpan)">
                            <DiscreteInt32KeyFrame KeyTime="0" Value="1" />
                        </Int32AnimationUsingKeyFrames>
                        <Int32AnimationUsingKeyFrames Storyboard.TargetName="AboutSection" Storyboard.TargetProperty="(Grid.Row)">
                            <DiscreteInt32KeyFrame KeyTime="0" Value="0" />
                        </Int32AnimationUsingKeyFrames>
                        <Int32AnimationUsingKeyFrames Storyboard.TargetName="AboutSection" Storyboard.TargetProperty="(Grid.RowSpan)">
                            <DiscreteInt32KeyFrame KeyTime="0" Value="3" />
                        </Int32AnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <settings:BackButton Margin="6,0,0,0" VerticalAlignment="Center" />
            <Image
                Grid.Column="1"
                Width="28"
                Height="28"
                Margin="6,0,0,0"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="Simple Pad" />
        </Grid>
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Grid.Row="1"
            Padding="18,0">
            <StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,14"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SettingsSection" Grid.ColumnSpan="3">
                        <TextBlock Text="Appearance" />
                        <ui:CardExpander Margin="0,12,0,0" ContentPadding="52,16,14,16">
                            <ui:CardExpander.Icon>
                                <ui:SymbolIcon Symbol="Color20" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="App theme" />
                                    <TextBlock
                                        Grid.Row="1"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Select which app theme to display" />
                                </Grid>
                            </ui:CardExpander.Header>
                            <themes:ThemeSettingsControl />
                        </ui:CardExpander>
                        <TextBlock Margin="0,12,0,0" Text="Text Formatting" />
                        <ui:CardExpander
                            x:Name="FontSettingsExpander"
                            Margin="0,12,0,0"
                            ContentPadding="0,0,0,0">
                            <ui:CardExpander.Icon>
                                <ui:SymbolIcon Symbol="TextFont20" />
                            </ui:CardExpander.Icon>
                            <Expander.Header>
                                <TextBlock Text="Font" />
                            </Expander.Header>
                            <StackPanel>
                                <ui:CardControl Padding="52,16,14,16" Header="Family">
                                    <fonts:FontFamilyComboBox />
                                </ui:CardControl>
                                <ui:CardControl Padding="52,16,14,16" Header="Style">
                                    <fonts:FontStyleComboBox />
                                </ui:CardControl>
                                <ui:CardControl Padding="52,16,14,16" Header="Size">
                                    <fonts:FontSizeComboBox />
                                </ui:CardControl>
                                <fonts:PreviewFontTextControl />
                            </StackPanel>
                        </ui:CardExpander>
                        <ui:CardControl Margin="0,12,0,0">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="TextWrap20" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Word wrap" />
                                    <TextBlock
                                        Grid.Row="1"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Fit text within window by default" />
                                </Grid>
                            </ui:CardControl.Header>
                            <editor:IsWordWrapSettingsControl />
                        </ui:CardControl>
                        <TextBlock Margin="0,12,0,0" Text="Opening Simple Pad" />
                        <ui:CardControl Margin="0,12,0,0">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Open20" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Opening files" />
                                    <TextBlock
                                        Grid.Row="1"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Choose where your files are opened" />
                                </Grid>
                            </ui:CardControl.Header>
                            <tabs:OpenFileBehaviorComboBox />
                        </ui:CardControl>
                        <TextBlock Margin="0,12,0,0" Text="Spelling" />
                        <ui:CardControl Margin="0,12,0,0">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="TextProofingTools20" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <TextBlock Text="Spell check" />
                            </ui:CardControl.Header>
                            <editor:IsSpellCheckEnabledSettingsControl />
                        </ui:CardControl>
                    </StackPanel>
                    <StackPanel
                        x:Name="AboutSection"
                        Grid.Row="2"
                        Grid.ColumnSpan="3">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About this app" />
                        <TextBlock Margin="0,8,0,0"><Run Text="Simple Pad " /><Run x:Name="VersionText" /></TextBlock>
                        <TextBlock Text="© 2026 h82258652. All rights reserved." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>