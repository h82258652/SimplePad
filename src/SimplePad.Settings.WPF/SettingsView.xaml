<UserControl
    x:Class="SimplePad.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SimplePad.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="1"
                Width="28"
                Height="28"
                Margin="6,0,0,0"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="2"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Text="Simple Pad" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,14"
                    Text="Settings" />
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SettingsSection" Grid.ColumnSpan="3">
                        <TextBlock Text="Appearance" />
                        <Expander Margin="0,12,0,0">
                            <Expander.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="App theme" />
                                    <TextBlock Grid.Row="1" Text="Select which app theme to display" />
                                </Grid>
                            </Expander.Header>
                        </Expander>
                        <TextBlock Margin="0,12,0,0" Text="Text Formatting" />
                        <Expander x:Name="FontSettingsExpander" Margin="0,12,0,0">
                            <Expander.Header>
                                <Grid>
                                    <TextBlock Text="Font" />
                                </Grid>
                            </Expander.Header>
                        </Expander>
                    </StackPanel>
                    <StackPanel
                        x:Name="AboutSection"
                        Grid.Row="2"
                        Grid.ColumnSpan="3">
                        <TextBlock Text="About this app" />
                        <TextBlock Margin="0,8,0,0"><Run Text="Simple Pad " /><Run x:Name="VersionText" /></TextBlock>
                        <TextBlock Text="© 2026 h82258652. All rights reserved." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>