<ui:ContentDialog
    x:Class="SimplePad.Editor.GoToLineDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SimplePad.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Go to line"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ButtonClicked="ContentDialog_ButtonClicked"
    CloseButtonText="Cancel"
    IsSecondaryButtonEnabled="False"
    PrimaryButtonAppearance="Primary"
    PrimaryButtonText="Go to"
    mc:Ignorable="d">
    <ui:ContentDialog.Style>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="local:GoToLineDialog2" />
    </ui:ContentDialog.Style>
    <HeaderedContentControl Header="Line number">
        <ui:NumberBox
            x:Name="LineNumberBox"
            Margin="0,8,0,0"
            Minimum="1" />
    </HeaderedContentControl>
</ui:ContentDialog>