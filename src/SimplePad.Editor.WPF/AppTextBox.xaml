<UserControl
    x:Class="SimplePad.Editor.AppTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="clr-namespace:SimplePad.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontSize="14"
    mc:Ignorable="d">
    <editor:AppTextBoxInternal
        x:Name="TextBoxInternal"
        CursorPositionChanged="OnTextBoxInternalCursorPositionChanged"
        SelectionChanged="OnTextBoxInternalSelectionChanged"
        TextChanged="OnTextBoxInternalTextChanged" />
</UserControl>