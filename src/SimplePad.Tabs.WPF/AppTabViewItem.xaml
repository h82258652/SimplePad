<TabItem
    x:Class="SimplePad.Tabs.AppTabViewItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="clr-namespace:SimplePad.Editor;assembly=SimplePad.Editor.WPF"
    xmlns:local="clr-namespace:SimplePad.Tabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="clr-namespace:SimplePad.Menu;assembly=SimplePad.Menu.WPF"
    xmlns:statusBar="clr-namespace:SimplePad.StatusBar;assembly=SimplePad.StatusBar.WPF"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <menu:AppMenuBar />
            <Button Grid.Column="1" Margin="0,0,8,0" />
        </Grid>
        <Rectangle Grid.Row="1" Height="1" />
        <editor:AppTextBox Grid.Row="2" />
        <Rectangle
            x:Name="StatusBarDivider"
            Grid.Row="3"
            Height="1" />
        <statusBar:AppStatusBar Grid.Row="4" />
    </Grid>
</TabItem>
