<ui:ContentDialog
    x:Class="SimplePad.Tabs.ConfirmCloseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SimplePad.Tabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Simple Pad"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ButtonClicked="OnButtonClick"
    CloseButtonText="Cancel"
    DialogMargin="0"
    PrimaryButtonText="Save"
    SecondaryButtonText="Don't save"
    mc:Ignorable="d">
    <ui:ContentDialog.Style>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="local:ConfirmCloseDialog" />
    </ui:ContentDialog.Style>
    <TextBlock MinWidth="318" TextWrapping="Wrap"><Run Text="Do you want to save changes to " /><Run x:Name="FileNameText" /><Run Text="?" /></TextBlock>
</ui:ContentDialog>