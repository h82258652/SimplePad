<UserControl
    x:Class="SimplePad.Search.SearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="clr-namespace:SimplePad.Search"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border>
        <search:SearchControlExpander>
            <search:SearchControlExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <search:SearchTextBox />
                    <Button Grid.Column="2" Grid.ColumnSpan="5" />
                    <search:SearchDownButton Grid.Column="2" />
                    <search:SearchUpButton Grid.Column="4" />
                    <Button Grid.Column="6" />
                    <search:ExitFindAndReplaceButton Grid.Column="8" />
                </Grid>
            </search:SearchControlExpander.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <search:ReplaceTextBox />
                <Button Grid.Column="2" Grid.ColumnSpan="3" />
                <search:ReplaceButton Grid.Column="2" />
                <search:ReplaceAllButton Grid.Column="4" />
            </Grid>
        </search:SearchControlExpander>
    </Border>
</UserControl>
