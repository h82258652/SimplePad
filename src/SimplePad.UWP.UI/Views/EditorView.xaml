<UserControl
    x:Class="SimplePad.UWP.UI.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SimplePad.UWP.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SimplePad.UWP.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:AppMenuBar EditorViewModel="{x:Bind ViewModel, Mode=OneWay}" TextBox="{x:Bind TextBox}" />
        <controls:AppTextBox
            x:Name="TextBox"
            Grid.Row="1"
            AcceptsReturn="True"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            CornerRadius="0"
            FontFamily="Consolas"
            FontSize="{x:Bind _appSettings.FontSize, Mode=OneWay}"
            IsSpellCheckEnabled="{x:Bind _appSettings.IsSpellCheckEnabled, Mode=OneWay}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionHighlightColorWhenNotFocused="{x:Bind TextBox.SelectionHighlightColor, Mode=OneWay}"
            Text="{x:Bind ViewModel.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="{x:Bind GetTextWrapping(_appSettings.IsWordWrap), Mode=OneWay}"
            ZoomFactor="{x:Bind _appState.ZoomFactor, Mode=TwoWay}" />
        <local:StatusBar
            Grid.Row="2"
            EditorViewModel="{x:Bind ViewModel, Mode=OneWay}"
            TextBox="{x:Bind TextBox}"
            Visibility="{x:Bind _appSettings.IsStatusBarVisible, Mode=OneWay}" />
    </Grid>
</UserControl>