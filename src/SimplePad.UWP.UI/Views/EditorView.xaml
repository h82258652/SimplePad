<UserControl
    x:Class="SimplePad.UWP.UI.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SimplePad.UWP.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:SimplePad.Editor.UWP.Controls"
    xmlns:local="using:SimplePad.UWP.UI.Views"
    xmlns:local1="using:SimplePad.StatusBar.UWP.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:AppMenuBar EditorViewModel="{x:Bind ViewModel, Mode=OneWay}" TextBox="{x:Bind TextBox}" />
        <editor:AppTextBox
            x:Name="TextBox"
            Grid.Row="1"
            Text="{x:Bind ViewModel.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <local1:AppStatusBar Grid.Row="2" TextBox="{x:Bind TextBox}" />
    </Grid>
</UserControl>
