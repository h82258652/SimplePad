<UserControl
    x:Class="SimplePad.UWP.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SimplePad.UWP.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="646" />
                    </VisualState.StateTriggers>
                    <!--  TODO increase padding  -->
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <!--  TODO  -->
                        <AdaptiveTrigger MinWindowWidth="1111" />
                    </VisualState.StateTriggers>
                    <!--  TODO move about to right  -->
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Orientation="Horizontal">
            <Button
                VerticalAlignment="Center"
                Click="OnBackButtonClick"
                Style="{StaticResource NavigationBackButtonNormalStyle}" />
            <Image
                Width="22"
                Height="22"
                VerticalAlignment="Center"
                Source="/Assets/Square44x44Logo.png" />
            <TextBlock VerticalAlignment="Center" Text="Simple Pad" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Settings" />
                    <TextBlock Text="Appearance" />
                    <controls:SettingsExpander Description="Select which app theme to display" Header="App theme">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <StackPanel>
                                    <RadioButton Content="Light" GroupName="AppTheme" />
                                    <RadioButton Content="Dark" GroupName="AppTheme" />
                                    <RadioButton Content="Use system setting" GroupName="AppTheme" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <TextBlock Text="Text Formatting" />
                    <controls:SettingsExpander Header="Font">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D2;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Family">
                                <ComboBox IsEditable="True" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Style">
                                <ComboBox>
                                    <ComboBoxItem Content="Regular" />
                                    <ComboBoxItem Content="Italic" />
                                    <ComboBoxItem Content="Bold" />
                                    <ComboBoxItem Content="Bold Italic" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="Size">
                                <ComboBox IsEditable="True" />
                            </controls:SettingsCard>
                            <controls:SettingsCard>
                                <TextBlock Text="The sound of ocean waves calms my soul." />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsCard Description="Fit text within window by default" Header="Word wrap">
                        <ToggleSwitch />
                    </controls:SettingsCard>
                    <TextBlock Text="Opening Simple Pad" />
                    <controls:SettingsCard Description="Choose where your files are opened" Header="Opening files">
                        <ComboBox>
                            <ComboBoxItem Content="Open in a new tab" />
                            <ComboBoxItem Content="Open in a new window" />
                        </ComboBox>
                    </controls:SettingsCard>
                </StackPanel>
                <StackPanel x:Name="AboutSection" Grid.Row="1">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About this app" />
                    <TextBlock Text="Simple Pad" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>