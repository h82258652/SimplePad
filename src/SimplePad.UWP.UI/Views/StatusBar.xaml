<UserControl
    x:Class="SimplePad.UWP.UI.Views.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SimplePad.UWP.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid MinHeight="32" Padding="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            x:Name="PositionIndicator"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Rectangle
            Grid.Column="1"
            Width="1"
            Height="16"
            Margin="8,0"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBlock
            x:Name="CharacterIndicator"
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Rectangle
            Grid.Column="4"
            Width="1"
            Height="16"
            Margin="8,0"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBlock
            x:Name="ZoomFactorIndicator"
            Grid.Column="5"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind GetZoomFactorText(_appState.ZoomFactor), Mode=OneWay}" />
    </Grid>
</UserControl>