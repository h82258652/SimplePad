<Window
    x:Class="SimplePad.Windowing.ShellWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="using:SimplePad.Search"
    xmlns:settings="using:SimplePad.Settings"
    xmlns:tabs="using:SimplePad.Tabs"
    Title="Simple Pad"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Closing="OnClosing"
    mc:Ignorable="d">
    <Panel>
        <Panel x:Name="ContentPanel">
            <tabs:AppTabView x:Name="TabView" />
            <search:SearchControl
                MaxWidth="860"
                Margin="8,88,8,0"
                VerticalAlignment="Top" />
        </Panel>
        <settings:SettingsView />
    </Panel>
</Window>
