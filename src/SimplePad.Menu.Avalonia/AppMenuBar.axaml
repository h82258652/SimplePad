<Menu
    x:Class="SimplePad.Menu.AppMenuBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="using:SimplePad.Menu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <MenuItem Header="File">
        <menu:NewTabMenuItem TabRoot="{Binding $self.Tab.Root}" />
        <menu:NewWindowMenuItem />
        <menu:OpenMenuItem />
        <menu:SaveMenuItem Tab="{Binding $self.Tab}" />
        <menu:CloseTabMenuItem />
        <menu:CloseWindowMenuItem />
    </MenuItem>
    <MenuItem Header="Edit" >
        <menu:UndoMenuItem />
        <menu:CutMenuItem />
        <menu:CopyMenuItem></menu:CopyMenuItem>
    </MenuItem>
    <MenuItem Header="View" />
</Menu>
