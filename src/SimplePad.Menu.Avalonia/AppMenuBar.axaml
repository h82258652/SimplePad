<Menu
    x:Class="SimplePad.Menu.AppMenuBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="using:SimplePad.Menu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <MenuItem Header="File">
        <menu:NewTabMenuItem TabRoot="{Binding $self.Tab.Root}" />
        <menu:NewWindowMenuItem />
        <menu:OpenMenuItem />
        <menu:SaveMenuItem Tab="{Binding $self.Tab}" />
        <Separator />
        <menu:CloseTabMenuItem />
        <menu:CloseWindowMenuItem />
        <menu:ExitMenuItem />
    </MenuItem>
    <MenuItem Header="Edit">
        <menu:UndoMenuItem />
        <Separator />
        <menu:CutMenuItem />
        <menu:CopyMenuItem />
        <menu:PasteMenuItem />
        <menu:DeleteMenuItem />
        <Separator />
        <menu:FindMenuItem />
        <menu:FindNextMenuItem />
        <menu:FindPreviousMenuItem />
        <menu:ReplaceMenuItem />
        <menu:GoToLineMenuItem />
        <Separator />
        <menu:SelectAllMenuItem />
        <menu:TimeDateMenuItem />
        <menu:FontMenuItem />
    </MenuItem>
    <MenuItem Header="View" />
</Menu>
