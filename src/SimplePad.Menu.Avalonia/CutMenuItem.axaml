<MenuItem
    x:Class="SimplePad.Menu.CutMenuItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menu="using:SimplePad.Menu"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Header="Cut"
    mc:Ignorable="d">
    <MenuItem.Command>
        <menu:CutCommand TextBox="{Binding $self.TextBox}" />
    </MenuItem.Command>
</MenuItem>