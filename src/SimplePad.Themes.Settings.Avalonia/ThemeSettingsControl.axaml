<UserControl
    x:Class="SimplePad.Themes.ThemeSettingsControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Spacing="8">
        <RadioButton
            x:Name="LightThemeRadioButton"
            Content="Light"
            GroupName="AppTheme"
            IsCheckedChanged="OnLightThemeRadioButtonIsCheckedChanged" />
        <RadioButton
            x:Name="DarkThemeRadioButton"
            Content="Dark"
            GroupName="AppTheme"
            IsCheckedChanged="OnDarkThemeRadioButtonIsCheckedChanged" />
        <RadioButton
            x:Name="UseSystemSettingsThemeRadioButton"
            Content="Use system setting"
            IsCheckedChanged="OnUseSystemSettingsThemeRadioButtonIsCheckedChanged" />
    </StackPanel>
</UserControl>